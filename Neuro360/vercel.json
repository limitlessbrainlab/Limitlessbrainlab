{
  "rewrites": [
    {
      "source": "/api/:path((?!send-report-email$|render-performance-pdf$|generate-performance-report$|ops/backend$).*)",
      "destination": "https://limitlessbrainlab-backend.onrender.com/api/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate-performance-report.js": {
      "maxDuration": 800
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(meditation-thumbs|brain-course)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
